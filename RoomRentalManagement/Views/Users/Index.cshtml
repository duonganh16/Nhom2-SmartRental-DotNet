
@model IEnumerable<RoomRentalManagement.Models.User>

@{
    ViewData["Title"] = "Quản lý tài khoản";

    var users = Model?.ToList() ?? new List<RoomRentalManagement.Models.User>();

    var totalUsers = users.Count;
    var adminCount = users.Count(x => x.Role == "Admin");
    var landlordCount = users.Count(x => x.Role == "Landlord");
    var tenantCount = users.Count(x => x.Role == "Tenant");

    var activeCount = users.Count(x => x.Status == "Active");
    var pendingCount = users.Count(x => x.Status == "Pending");
    var rejectedCount = users.Count(x => x.Status == "Rejected");
}

<style>
    body {
        background: #f4f6fb;
    }

    .user-page {
        padding: 10px 5px 30px;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 22px;
    }

    .page-heading h2 {
        color: #1e293b;
        font-size: 27px;
        font-weight: 700;
        margin: 0;
    }

    .page-subtitle {
        color: #64748b;
        margin-top: 6px;
        font-size: 14px;
    }

    .user-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 22px;
    }

    .stat-card {
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 13px;
        padding: 18px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .035);
    }

    .stat-icon {
        float: right;
        width: 39px;
        height: 39px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .stat-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 9px;
    }

    .stat-value {
        color: #1e293b;
        font-size: 27px;
        font-weight: 700;
    }

    .icon-blue { background: #eff6ff; }
    .icon-green { background: #ecfdf5; }
    .icon-yellow { background: #fffbeb; }
    .icon-red { background: #fef2f2; }

    .user-panel {
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .035);
        overflow: hidden;
    }

    .panel-header {
        padding: 19px 22px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .panel-header h5 {
        margin: 0;
        color: #1e293b;
        font-weight: 700;
    }

    .user-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 20px;
    }

    .user-actions a {
        text-decoration: none;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .action-all {
        background: #2563eb;
        color: white;
    }

    .action-landlord {
        background: #0891b2;
        color: white;
    }

    .action-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .action-create {
        background: #16a34a;
        color: white;
    }

    .user-actions a:hover {
        filter: brightness(.95);
        color: inherit;
    }

    .action-all:hover,
    .action-landlord:hover,
    .action-create:hover {
        color: white !important;
    }

    .search-box {
        position: relative;
        width: 100%;
        max-width: 310px;
    }

    .search-box input {
        width: 100%;
        padding: 9px 12px 9px 36px;
        border: 1px solid #dbe2ea;
        border-radius: 8px;
        outline: none;
    }

    .search-box input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, .1);
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 9px;
        color: #94a3b8;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .user-table {
        width: 100%;
        min-width: 750px;
        border-collapse: collapse;
        margin: 0;
    }

    .user-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 14px 16px;
        border-bottom: 1px solid #e8edf5;
        white-space: nowrap;
    }

    .user-table tbody td {
        padding: 15px 16px;
        border-bottom: 1px solid #f0f2f6;
        color: #334155;
        font-size: 14px;
        vertical-align: middle;
    }

    .user-table tbody tr:hover {
        background: #f8fbff;
    }

    .user-id {
        color: #2563eb;
        font-weight: 700;
    }

    .user-name {
        color: #1e293b;
        font-weight: 600;
    }

    .username {
        color: #64748b;
    }

    .role-badge,
    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .role-admin {
        color: #6d28d9;
        background: #f3e8ff;
    }

    .role-landlord {
        color: #0369a1;
        background: #e0f2fe;
    }

    .role-tenant {
        color: #475569;
        background: #f1f5f9;
    }

    .status-active {
        color: #15803d;
        background: #dcfce7;
    }

    .status-pending {
        color: #92400e;
        background: #fef3c7;
    }

    .status-rejected {
        color: #b91c1c;
        background: #fee2e2;
    }

    .status-other {
        color: #475569;
        background: #f1f5f9;
    }

    .empty-state {
        text-align: center;
        padding: 42px 15px !important;
        color: #94a3b8 !important;
    }

    .panel-footer {
        padding: 14px 22px;
        border-top: 1px solid #edf0f5;
        color: #64748b;
        font-size: 13px;
    }

    @@media (max-width: 1000px) {
        .user-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 576px) {
        .user-stats {
            grid-template-columns: 1fr;
        }

        .page-heading h2 {
            font-size: 23px;
        }

        .panel-header {
            align-items: stretch;
        }

        .search-box {
            max-width: 100%;
        }
    }
</style>

<div class="user-page">

    <div class="page-heading">
        <div>
            <h2>Quản lý tài khoản</h2>
            <div class="page-subtitle">
                Quản lý tài khoản và theo dõi trạng thái người dùng trong hệ thống
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="user-stats">
        <div class="stat-card">
            <div class="stat-icon icon-blue">👥</div>
            <div class="stat-label">Tổng tài khoản</div>
            <div class="stat-value">@totalUsers</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-green">✓</div>
            <div class="stat-label">Đã kích hoạt</div>
            <div class="stat-value">@activeCount</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-yellow">⏳</div>
            <div class="stat-label">Chờ duyệt</div>
            <div class="stat-value">@pendingCount</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-red">✕</div>
            <div class="stat-label">Bị từ chối</div>
            <div class="stat-value">@rejectedCount</div>
        </div>
    </div>

    <div class="user-actions">
        <a asp-controller="Users" asp-action="Index" class="action-all">
            Tất cả tài khoản (@totalUsers)
        </a>

        <a asp-controller="Users" asp-action="Landlords" class="action-landlord">
            Danh sách chủ nhà (@landlordCount)
        </a>

        <a asp-controller="Users" asp-action="Pending" class="action-pending">
            Tài khoản chờ duyệt (@pendingCount)
        </a>

        <a asp-controller="Users" asp-action="Create" class="action-create">
            ＋ Tạo tài khoản mới
        </a>
    </div>

    <div class="user-panel">
        <div class="panel-header">
            <h5>Danh sách tất cả tài khoản</h5>

            <div class="search-box">
                <span class="search-icon">⌕</span>
                <input type="text"
                       id="userSearch"
                       placeholder="Tìm tên, tài khoản, vai trò..."
                       autocomplete="off" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="user-table">
                <thead>
                    <tr>
                        <th>Mã tài khoản</th>
                        <th>Họ và tên</th>
                        <th>Tên đăng nhập</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>

                <tbody id="userTableBody">
                    @if (users.Any())
                    {
                        @foreach (var user in users)
                        {
                            <tr class="user-row">
                                <td>
                                    <span class="user-id">#@user.UserID</span>
                                </td>

                                <td>
                                    <span class="user-name">@user.FullName</span>
                                </td>

                                <td>
                                    <span class="username">@user.Username</span>
                                </td>

                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="role-badge role-admin">Quản trị viên</span>
                                    }
                                    else if (user.Role == "Landlord")
                                    {
                                        <span class="role-badge role-landlord">Chủ nhà</span>
                                    }
                                    else if (user.Role == "Tenant")
                                    {
                                        <span class="role-badge role-tenant">Người thuê</span>
                                    }
                                    else
                                    {
                                        <span class="role-badge role-tenant">@user.Role</span>
                                    }
                                </td>

                                <td>
                                    @if (user.Status == "Active")
                                    {
                                        <span class="status-badge status-active">Đã kích hoạt</span>
                                    }
                                    else if (user.Status == "Pending")
                                    {
                                        <span class="status-badge status-pending">Chờ duyệt</span>
                                    }
                                    else if (user.Status == "Rejected")
                                    {
                                        <span class="status-badge status-rejected">Bị từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-other">
                                            @(string.IsNullOrWhiteSpace(user.Status) ? "Chưa xác định" : user.Status)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty-state">
                                Chưa có tài khoản nào trong hệ thống.
                            </td>
                        </tr>
                    }

                    <tr id="noUserResult" style="display:none;">
                        <td colspan="5" class="empty-state">
                            Không tìm thấy tài khoản phù hợp.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="panel-footer">
            Tổng cộng <strong>@totalUsers</strong> tài khoản
            <span class="ms-2">
                (Admin: @adminCount · Chủ nhà: @landlordCount · Người thuê: @tenantCount)
            </span>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("userSearch");
        const rows = document.querySelectorAll(".user-row");
        const noResult = document.getElementById("noUserResult");

        if (!searchInput) return;

        searchInput.addEventListener("input", function () {
            const keyword = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(function (row) {
                const matched = row.innerText.toLowerCase().includes(keyword);

                row.style.display = matched ? "" : "none";

                if (matched) visibleCount++;
            });

            if (noResult) {
                noResult.style.display =
                    visibleCount === 0 && rows.length > 0 ? "" : "none";
            }
        });
    });
</script>
